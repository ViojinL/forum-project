generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                      String             @id @default(uuid())
  email                   String             @unique
  username                String             @unique
  password                String
  isAdmin                 Boolean            @default(false)
  creditScore             Int                @default(100)
  banUntil                DateTime?
  contactInfo             String?
  signature               String?
  avatar                  String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  comments                Comment[]
  violationMarkedComments CommentViolation[] @relation("MarkedByAdmin")
  posts                   Post[]
  violationMarkedPosts    PostViolation[]    @relation("MarkedByAdmin")
  inbox                   UserInbox[]
  knowledgeBase           KnowledgeBase[]
  announcements           Announcement[]
  questionsRouted         QuestionRouting[]
  aiModerationConfig      AIModerationConfig[]
  
  // NextAuth相关字段
  name                    String?
  image                   String?
  emailVerified           DateTime?
  accounts                Account[]
  sessions                Session[]
}

model Category {
  id             String          @id @default(uuid())
  name           String          @unique
  description    String?
  posts          Post[]
  knowledgeItems KnowledgeBase[]
}

model Post {
  id            String            @id @default(uuid())
  title         String
  content       String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  authorId      String
  categoryId    String
  isViolation   Boolean           @default(false)
  editCount     Int               @default(0)
  comments      Comment[]
  author        User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category      Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  violations    PostViolation[]
  routings      QuestionRouting[]
  moderationLog PostModerationLog[]
}

model Comment {
  id             String                @id @default(uuid())
  content        String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  authorId       String
  postId         String
  isViolation    Boolean               @default(false)
  editCount      Int                   @default(0)
  parentId       String?
  parent         Comment?              @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        Comment[]             @relation("CommentReplies")
  author         User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post           Post                  @relation(fields: [postId], references: [id], onDelete: Cascade)
  violations     CommentViolation[]
  moderationLog  CommentModerationLog[]
}

model PostViolation {
  id             String   @id @default(uuid())
  postId         String
  adminId        String
  reason         String
  pointsDeducted Int
  createdAt      DateTime @default(now())
  markedByAdmin  User     @relation("MarkedByAdmin", fields: [adminId], references: [id])
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, adminId])
}

model CommentViolation {
  id             String   @id @default(uuid())
  commentId      String
  adminId        String
  reason         String
  pointsDeducted Int
  createdAt      DateTime @default(now())
  markedByAdmin  User     @relation("MarkedByAdmin", fields: [adminId], references: [id])
  comment        Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, adminId])
}

model UserInbox {
  id               String   @id @default(uuid())
  userId           String
  message          String
  type             String
  relatedPostId    String?
  relatedCommentId String?
  isRead           Boolean  @default(false)
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}



model KnowledgeBase {
  id          String    @id @default(cuid())
  question    String
  answer      String    // 移除 @db.Text - SQLite不支持
  timesUsed   Int       @default(0)
  categoryId  String?  
  category    Category?  @relation(fields: [categoryId], references: [id])
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  content     String    // 移除 @db.Text - SQLite不支持
  isActive    Boolean   @default(true)
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model QuestionRouting {
  id          String    @id @default(uuid())
  questionId  String
  routedToId  String
  status      String    @default("pending") // pending, answered, rejected
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  question    Post      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  routedTo    User      @relation(fields: [routedToId], references: [id], onDelete: Cascade)
}

model AIModerationConfig {
  id                   String    @id @default(cuid())
  autoMarkThreshold    Float     @default(0.92) // 自动标记违规内容的阈值
  notifyAdminThreshold Float     @default(0.85) // 通知管理员的阈值
  enableAutoDeduction Boolean   @default(true) // 是否启用自动扣分
  lastUpdated          DateTime  @default(now()) @updatedAt
  updatedBy            String?   // 更新者的ID
  user                 User?     @relation(fields: [updatedBy], references: [id])
}

model CommentModerationLog {
  id              String   @id @default(cuid())
  commentId       String
  flagged         Boolean
  highestCategory String
  highestScore    Float
  fullResultJson  String
  createdAt       DateTime @default(now())
  comment         Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
}

model PostModerationLog {
  id              String   @id @default(cuid())
  postId          String
  flagged         Boolean
  highestCategory String
  highestScore    Float
  fullResultJson  String
  createdAt       DateTime @default(now())
  post            Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

// NextAuth required tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
